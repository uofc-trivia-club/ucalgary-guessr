# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-string
APP_BASE_URL=http://localhost:3000

# Database (server-side only)
# Leave both empty for local SQLite development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email
# "console" prints magic-login and password-reset links to the server console.
# "smtp" sends real email through the SMTP settings below.
EMAIL_MODE=console
EMAIL_FROM=UCalgaryGuessr <no-reply@example.com>

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
